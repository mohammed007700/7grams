rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && email() == 'osopp2016@gmail.com'; }
    function hasMember() { return signedIn() && exists(/databases/$(database)/documents/members/$(email())); }
    function member() { return get(/databases/$(database)/documents/members/$(email())).data; }
    function isAdmin() { return isOwner() || (hasMember() && member().role == 'admin'); }
    function isStaff() { return hasMember(); }
    function myBranch() { return member().branch; }
    function mine() { return isStaff() && resource != null && resource.data.branch == myBranch(); }
    function writesMine() { return isStaff() && request.resource.data.branch == myBranch() && (resource == null || resource.data.branch == myBranch()); }

    match /members/{id} {
      allow read: if isAdmin() || (signedIn() && id == email());
      allow write: if isAdmin();
    }
    match /settings/{id} { allow read: if isAdmin() || isStaff(); allow write: if isAdmin(); }
    match /prices/{id}   { allow read: if isAdmin() || isStaff(); allow write: if isAdmin(); }
    match /menu/{id}     { allow read, write: if isAdmin(); }
    match /menub/{id}    { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /sales/{id} { allow read, write: if isAdmin(); }
    match /waste/{id} { allow read, write: if isAdmin(); }
    match /salesb/{id}   { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /wasteb/{id}   { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /orders/{id}   { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /staff/{id}    { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /reviews/{id}  { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /comments/{id} { allow read: if isAdmin() || mine(); allow write: if isAdmin(); }
    match /stock/{id}    { allow read: if isAdmin() || mine(); allow create, update: if isAdmin() || writesMine(); allow delete: if isAdmin(); }
    match /empsales/{id} { allow read: if isAdmin() || mine(); allow create, update: if isAdmin() || writesMine(); allow delete: if isAdmin(); }
    match /tasklog/{id}  { allow read: if isAdmin() || mine(); allow create, update: if isAdmin() || writesMine(); allow delete: if isAdmin(); }
    match /taskpics/{id} { allow read: if isAdmin() || mine(); allow create, update: if isAdmin() || writesMine(); allow delete: if isAdmin(); }
    match /invent/{id}   { allow read: if isAdmin() || mine(); allow create, update: if isAdmin() || writesMine(); allow delete: if isAdmin(); }
    match /employees/{id} { allow read: if isAdmin() || (signedIn() && resource.data.email == email()); allow write: if isAdmin(); }
    match /empdocs/{id}   { allow read: if isAdmin() || (signedIn() && resource.data.email == email()); allow write: if isAdmin(); }
  }
}

